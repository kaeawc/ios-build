#!/usr/bin/env bash

set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

echo "Running pre-commit hooks..."

# Validate shell scripts with shellcheck
if command -v shellcheck &>/dev/null; then
  echo "→ Checking shell scripts..."
  ONLY_TOUCHED_FILES=true bash "$PROJECT_ROOT/scripts/shellcheck/validate_shell_scripts.sh"
else
  echo "⚠ shellcheck not installed, skipping shell script validation"
fi

# Format Swift files with swiftformat
if command -v swiftformat &>/dev/null; then
  echo "→ Formatting Swift files..."
  ONLY_TOUCHED_FILES=true bash "$PROJECT_ROOT/scripts/swiftformat/apply_swiftformat.sh"
else
  echo "⚠ swiftformat not installed, skipping Swift formatting"
fi

# Lint Swift files with swiftlint
if command -v swiftlint &>/dev/null; then
  echo "→ Linting Swift files..."
  ONLY_TOUCHED_FILES=true bash "$PROJECT_ROOT/scripts/swiftlint/apply_swiftlint.sh"
else
  echo "⚠ swiftlint not installed, skipping Swift linting"
fi

echo "Pre-commit checks passed!"
