#!/usr/bin/env bash
#
# Checks staged files before each commit. Enable with: git config core.hooksPath .githooks
# Skip once with `git commit --no-verify`.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

warn_missing() {
  echo "⚠ $1 not installed, skipping (run: mise install)"
}

swift_files=()
while IFS= read -r file; do
  swift_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')

if [[ ${#swift_files[@]} -gt 0 ]]; then
  if command -v swiftformat >/dev/null 2>&1; then
    echo "→ SwiftFormat"
    swiftformat --lint --quiet "${swift_files[@]}" || {
      echo "Run 'bash scripts/format.sh', then stage the changes."
      exit 1
    }
  else
    warn_missing swiftformat
  fi

  if command -v swiftlint >/dev/null 2>&1; then
    echo "→ SwiftLint"
    swiftlint lint --strict --quiet "${swift_files[@]}"
  else
    warn_missing swiftlint
  fi
fi

if command -v shellcheck >/dev/null 2>&1; then
  echo "→ ShellCheck"
  ONLY_TOUCHED_FILES=true bash scripts/shellcheck/validate_shell_scripts.sh
else
  warn_missing shellcheck
fi
