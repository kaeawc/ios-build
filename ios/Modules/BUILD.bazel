# Bazel targets for the modules in Package.swift: one swift_library per module and, per test
# target, Swift Testing suites on the macOS host (`<Name>Tests`) and on the iPhone and iPad
# simulators (`<Name>Tests_iPhone`, `<Name>Tests_iPad`). Keep this file in sync with Package.swift.

load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("//bazel:swift.bzl", "MAIN_ACTOR_COPTS", "SWIFT_FEATURES", "swift_module_tests")
load("//ios/StarterApp:config.bzl", "IOS_MINIMUM_OS")

IOS_RUNNERS = {
    "iPad": "//bazel:ipad_runner",
    "iPhone": "//bazel:iphone_runner",
}

package(
    default_visibility = ["//visibility:public"],
    features = SWIFT_FEATURES,
)

exports_files([
    "Package.resolved",
    "Package.swift",
])

# MARK: Features (SwiftUI, main-actor isolated by default)

swift_library(
    name = "AppFeature",
    srcs = glob(["Sources/AppFeature/**/*.swift"]),
    copts = MAIN_ACTOR_COPTS,
    module_name = "AppFeature",
    deps = [
        ":Connectivity",
        ":Persistence",
        "@swiftpkg_swift_dependencies//:Dependencies",
    ],
)

swift_module_tests(
    name = "AppFeatureTests",
    srcs = glob(["Tests/AppFeatureTests/**/*.swift"]),
    copts = MAIN_ACTOR_COPTS,
    ios_minimum_os = IOS_MINIMUM_OS,
    ios_runners = IOS_RUNNERS,
    deps = [
        ":AppFeature",
        ":Connectivity",
        ":Persistence",
        "@swiftpkg_swift_dependencies//:Dependencies",
        "@swiftpkg_swift_dependencies//:DependenciesTestSupport",
    ],
)

# MARK: Clients & data (no UI, nonisolated by default)

swift_library(
    name = "Connectivity",
    srcs = glob(["Sources/Connectivity/**/*.swift"]),
    module_name = "Connectivity",
    deps = [
        "@swiftpkg_alamofire//:Alamofire",
        "@swiftpkg_swift_dependencies//:Dependencies",
    ],
)

swift_module_tests(
    name = "ConnectivityTests",
    srcs = glob(["Tests/ConnectivityTests/**/*.swift"]),
    ios_minimum_os = IOS_MINIMUM_OS,
    ios_runners = IOS_RUNNERS,
    deps = [
        ":Connectivity",
        "@swiftpkg_alamofire//:Alamofire",
    ],
)

swift_library(
    name = "Persistence",
    srcs = glob(["Sources/Persistence/**/*.swift"]),
    module_name = "Persistence",
    deps = [
        "@swiftpkg_grdb.swift//:GRDB",
        "@swiftpkg_swift_dependencies//:Dependencies",
    ],
)

swift_module_tests(
    name = "PersistenceTests",
    srcs = glob(["Tests/PersistenceTests/**/*.swift"]),
    ios_minimum_os = IOS_MINIMUM_OS,
    ios_runners = IOS_RUNNERS,
    deps = [
        ":Persistence",
        "@swiftpkg_grdb.swift//:GRDB",
    ],
)
