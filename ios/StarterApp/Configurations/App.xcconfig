// The app target: iPhone, iPad, Apple TV and Apple Vision Pro from one target. Use
// `[sdk=...]` conditions for per-platform values (iphone*, appletv*, xr*).

PRODUCT_NAME = $(APP_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER)
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
ENABLE_PREVIEWS = YES

// Native apps on every platform rather than the iPad app running on a Mac or Vision Pro.
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
// Each platform has its own icon format: an app icon set on iOS, a brand asset (layered icon and
// Top Shelf images) on tvOS and a layered image stack on visionOS. The placeholders come from
// scripts/icons/generate.sh; replace them with real artwork before shipping.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_APPICON_NAME[sdk=appletv*] = AppIcon-tvOS
ASSETCATALOG_COMPILER_APPICON_NAME[sdk=xr*] = AppIcon-visionOS

// Info.plist is generated from these keys; there is no Info.plist file to maintain.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
// iPad apps must support every orientation to take part in multitasking (Split View, Stage Manager).
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UIApplicationPreferredDefaultSceneSessionRole[sdk=xr*] = UIWindowSceneSessionRoleApplication
